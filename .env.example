# ---------------------------------------------------------------------------
# Template only — copy to `.env` for local development.
# NEVER commit a real `.env` file or real credentials.
# On Render set these in: Dashboard → Service → Environment.
# ---------------------------------------------------------------------------

# Server
# `PORT` is injected by Render automatically — do NOT set it in the dashboard.
PORT=5000
NODE_ENV=development

# Database (required)
MONGO_URI=

# JWT (required)
JWT_SECRET=

# CORS / Socket.IO: comma separated list of allowed frontend origins.
# https://chat-app-frontend-gules-one.vercel.app is always allowed, even when
# CLIENT_URL is not set. Never use "*" here (credentials are enabled).
CLIENT_URL=http://localhost:5173,https://chat-app-frontend-gules-one.vercel.app

# Cloudinary (optional) — falls back to local ./uploads when empty
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional) — MUST be a full connection URL, never a bare password.
#   rediss://default:<password>@<host>:<port>   -> TLS (Redis Cloud, Upstash, Render Key Value ...)
#   redis://default:<password>@<host>:<port>    -> plain TCP
# Leave empty to run without Redis (caching disabled + Socket.IO in-memory adapter).
REDIS_URL=

# Push notifications (optional)
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
